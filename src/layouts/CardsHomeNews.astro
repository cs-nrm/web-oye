---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const res = await fetch("https://contenido.oyedigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,acf,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=20&categories=149");
const posts = await res.json();
const filteredPosts = posts.filter((post:any) => !post.acf?.fijo);
---

      <div class="container">
        <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl ">Breaking News</h1>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Noticia principal (66%) -->
        <div class="lg:col-span-2">
          <a href={`/breakingnews/${posts[0].slug}/`}>
          <div class="relative h-full">
            <img class="rounded-xl w-full h-full object-cover" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/>
            <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
              <h2 class="text-xl lg:text-2xl font-bold" set:html={posts[0].title.rendered}></h2>
            </div>
          </div>
          </a>
        </div>

        <!-- Columna lateral con dos noticias secundarias -->
        <div class="flex flex-col gap-4">
          <!-- Secundaria 1 -->

          <div class="relative h-1/2">
            <a href={`/breakingnews/${posts[1].slug}/`}>
              <img class="rounded-xl w-full h-full object-cover" src={posts[1]._embedded['wp:featuredmedia'][0].media_details.sizes['oye-size'].source_url} alt="Imagen Breaking News"/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                <p class="text-md font-semibold rounded-b-xl mb-0" set:html={posts[1].title.rendered}></p>
              </div>
            </a>
          </div>
          <!-- Secundaria 2 -->
          <div class="relative h-1/2">
            <a href={`/breakingnews/${posts[2].slug}/`}>
              <img class="rounded-xl w-full h-full object-cover" src={posts[2]._embedded['wp:featuredmedia'][0].media_details.sizes['oye-size'].source_url} alt="Imagen Breaking News"/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                <p class="text-md font-semibold rounded-b-xl mb-0" set:html={posts[2].title.rendered}></p>
              </div>
            </a>
          </div>
        </div>
      </div>
        <!--div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-16 xl:gap-16">
           {
          filteredPosts.slice(0, 4).map((post:any, idx:number) => (
            <div class={`cards-filtro-${idx}`}>
              <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
                <a href={`/breakingnews/${post.slug}/`}>
                  <div><img class="rounded-xl" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['oye-size'].source_url} alt="Imagen Breaking News"/></div>
                  <div class="news-content">
                    <p set:html={post.title.rendered}></p>
                    <div class="text-sm resumen" set:html={post.excerpt.rendered}></div>
                    <span class="roboto font-bold text-xs mt-4">por {post.yoast_head_json.author}</span>
                  </div>
                </a>  
              </article>
            </div>
          ))
          }
        </div-->
      </div>

<div class="m-auto text-center">
    <a href="/noticias" class="text-white hover:text-black">
        <button class="ver-mas group relative rounded-sm h-8 m-2 overflow-hidden bg-[#f61842] uppercase text-xs font-bold tracking-[1px]">
            <span class="p-4">MÁS NOTICIAS AQUÍ</span>
        </button>
    </a>
</div>

<style>
.cards-filtro-3{display: none;}

@media (min-width: 769px) and (max-width: 1024px){
  .cards-filtro-3{display: block;}
}

.news-content p{
  font-size: 1rem;
  padding: 15px 0;
  line-height: 1;
  font-weight: bold;
}
