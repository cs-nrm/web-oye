---
import { PODCASTS } from '../consts';

const PODCAST_CATEGORIES = PODCASTS.map(p => p.nodo).join(',');
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/oye/recursos/img_oye-min.jpg';

const res = await fetch(
  `https://playnrm.com/wp-json/wp/v2/posts?_fields=date,title,slug,acf,_links,_embedded&_embed&per_page=1&categories=${PODCAST_CATEGORIES}&orderby=date&order=desc`
);
const posts: any[] = await res.json();
const post = posts[0];

const featuredImg = post?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['full']?.source_url
  || post?._embedded?.['wp:featuredmedia']?.[0]?.source_url
  || PLACEHOLDER_IMG;

const publishedDate = post?.date ? post.date.substring(0, 10) : '';

const podcast = PODCASTS.find(p => post?.categories?.includes(p.nodo));
---

<h2 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl">OYE EL PODCAST</h2>
<div class="flex flex-nowrap items-center flex-col mb-8">
  <div class="w-[70%]">
    <img
      class="rounded-xl m-auto max-w-[365px]"
      src={featuredImg}
      alt={post?.title?.rendered || "Imagen Podcast"}
    />
  </div>
  <div class="news-content audiopod py-2 pr-4">
    {podcast && (
      <h3 class="uppercase font-bold">{podcast.title}</h3>
    )}
    <p class="text-xl m-0" set:html={post?.title?.rendered}></p>
    <p class="text-zinc-500">{publishedDate}</p>
    <div class="flex items-center gap-5 play-pause-podcast cursor-pointer play-pause-podcast-home" data-podcast-status="ready">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-player-play" width="60" height="60" viewBox="0 0 24 24" stroke-width="2" stroke="#fff" fill="#fff" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
      <span>REPRODUCIR AHORA</span>
    </div>
    <div class="data-iframe" data-iframe={post?.acf?.ds}></div>
  </div>
</div>

<style>
.carousel-cell img, .circle-podcast img {
  border-radius: 50%;
  box-shadow: 0 2px 12px 7px rgba(0,0,0,0.4);
  margin-top: 20px;
}
</style>
