---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


let posts: any[] = [];
try {
  const res = await fetch("https://playnrm.com/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=6&categories=6616&order_by=date&order=desc");
  if (res.ok) posts = await res.json();
} catch (e) { console.error('[CardsHomeCine]', e); }
const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/oye/recursos/img_oye-min.jpg';
---

      <div class="container">
        <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl ">OYE DE CINE</h1>
        <div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 md:gap-16 xl:gap-16">
          <!-- Article 1 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/cine/${posts[0].slug}/`}>
              <div><img loading="lazy" class="rounded-xl inset-0 h-auto sm:h-64 md:h-80 w-full shadow-lg object-cover object-center" src={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Cine"}/></div>
              <div class="news-content">
                <p set:html={posts[0].title.rendered}></p>
                <!--div class="text-sm resumen" set:html={posts[0].excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {posts[0].yoast_head_json.author}</span-->
              </div>
            </a>  
          </article>

          <!-- Article 2 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/cine/${posts[1].slug}/`}>
              <div><img loading="lazy" class="rounded-xl inset-0 h-auto sm:h-64 md:h-80 w-full shadow-lg object-cover object-center" src={posts[1]?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={posts[1]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Cine"}/></div>
              <div class="news-content">
                <p set:html={posts[1].title.rendered}></p>
                <!--div class="text-sm resumen" set:html={posts[1].excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {posts[1].yoast_head_json.author}</span-->
              </div>
            </a>  
          </article>

          <!-- Article 3 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/cine/${posts[2].slug}/`}>
              <div><img loading="lazy" class="rounded-xl inset-0 h-auto sm:h-64 md:h-80 w-full shadow-lg object-cover object-center" src={posts[2]?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={posts[2]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Cine"}/></div>
              <div class="news-content">
                <p set:html={posts[2].title.rendered}></p>
                <!--div class="text-sm resumen" set:html={posts[2].excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {posts[2].yoast_head_json.author}</span-->
              </div>
            </a>  
          </article>

          <!-- Article 4 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/cine/${posts[3].slug}/`}>
              <div><img loading="lazy" class="rounded-xl inset-0 h-auto sm:h-64 md:h-80 w-full shadow-lg object-cover object-center" src={posts[3]?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['small-feature']?.source_url || PLACEHOLDER_IMG} alt={posts[3]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text || "Imagen Cine"}/></div>
              <div class="news-content">
                <p set:html={posts[3].title.rendered}></p>
                <!--div class="text-sm resumen" set:html={posts[3].excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {posts[3].yoast_head_json.author}</span-->
              </div>
            </a>  
          </article>
        </div>
      </div>

<div class="m-auto text-center">
    <a href="/cine" class="text-white hover:text-black">
        <button class="ver-mas group relative rounded-sm h-8 m-2 overflow-hidden bg-[#e2241a] uppercase text-xs font-bold tracking-[1px]">
            <span class="p-4">MUCHO MÁS CINE AQUÍ</span>
        </button>
    </a>
</div>

<style>
.news-content p{
  font-size: 1rem;
  padding: 15px 0;
  line-height: 1;
  font-weight: bold;
}
