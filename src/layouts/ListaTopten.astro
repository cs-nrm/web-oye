---
import { Image } from 'astro:assets';

const res = await fetch("https://playnrm.com/wp-json/wp/v2/posts?_embed&per_page=10&categories=280&order=asc&_fields=id,title,acf,content,slug,categories,_links,_embedded&orderby=acf_posicion&order=asc");
const posts = await res.json();

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/oye/recursos/img_oye-min.jpg';
---
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl ">OYE LO + TOP</h1>
