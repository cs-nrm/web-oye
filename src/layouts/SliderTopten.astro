---
import { Image } from 'astro:assets';

const res = await fetch("https://contenido.oyedigital.mx/wp-json/wp/v2/posts?_embed&per_page=10&categories=280&_fields=id,title,yoast_head_json,content,slug,categories,_links,_embedded");
const posts = await res.json();
---


    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl ">OYE EL TOP TEN</h1>
    <div class="flex items-center">
        <div class="news-content audiopod w-[50%] py-2 pr-4">
			<h3 class="uppercase font-bold" set:html={posts[0].yoast_head_json.schema['@graph'][0].articleSection[0]}></h3>	
            <p class="text-xl m-0" set:html={posts[0].title.rendered}></p>
			<p class="text-zinc-500">{posts[0].yoast_head_json.article_published_time.substring(0, 10)}</p>
			<div class="flex items-center gap-5 play-pause-podcast cursor-pointer play-pause-podcast-home" data-podcast-status="ready"> 
          		<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-player-play" width="60" height="60" viewBox="0 0 24 24" stroke-width="2" stroke="#fff" fill="#fff" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
				<span>REPRODUCIR AHORA</span>
			</div> 
			<!--div class="data-iframe" data-iframe={posts[0].acf.ds}></div-->
        </div>
        <div class="w-[50%]"><img class="rounded-xl" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['oye-size'].source_url} alt="Imagen Breaking News"/></div>
    </div>

<!--div class="main-carousel" data-flickity='{ "lazyLoad": 1, "wrapAround": true, "cellAlign": "center", "pageDots": false, "autoPlay": true}'-->
<div class="main-carousel px-4">
	{
	posts.map((post:any, index)=> (

		<a class=" flex flex-wrap items-center text-black hover:text-[#7b439b] w-1/2 sm:w-1/2 lg:w-1/2 px-8 mb-8" href={`/topten`}>
			<div class="w-2/12 text-center">
				<span class="text-4xl font-bold" set:html={index+1}></span>
			</div>
			<div class="w-4/12">
				<Image class="block h-auto w-full shadow-[0_2px_12px_7px_rgba(0,0,0,0.4)] rounded object-fill" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['thumbnail'].source_url} width="300" height="150" alt="Imagen Ilustrativa Top Ten"  />
			</div>
			<div class="w-6/12">
				<p class="font-bold leading-none p-4 text-lg" set:html={post.title.rendered}></p>
			</div>
		</a>

	))    
	}
</div>




<style>
.carousel-cell {
  width: 150px;
  height: 200px;
  margin-right: 80px;
  border-radius: 20px;
}

.carousel-cell img{
	border-radius: 50%;
	box-shadow: 0 2px 12px 7px rgba(0,0,0,0.4);
	margin-top: 20px;
}

.carousel-cell.is-selected {
  /*background: #ED2;*/
}
</style>