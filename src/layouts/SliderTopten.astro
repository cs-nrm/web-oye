---
import { Image } from 'astro:assets';

const res = await fetch("https://contenido.oyedigital.mx/wp-json/wp/v2/posts?_embed&per_page=10&categories=280&order=asc&_fields=id,title,acf,yoast_head_json,content,slug,categories,_links,_embedded");
const posts = await res.json();

---
    <h1 class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl ">OYE EL TOP TEN</h1>
    <div class="block md:flex items-center bg-[#ededed] rounded-xl">
        <div class="w-[100%] md:w-[50%] relative">
			<img class="rounded-xl" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['oye-size'].source_url} alt="Imagen Breaking News"/>
			<span class="text-8xl font-bold absolute bottom-2 left-4 lg:bottom-8 lg:left-8 rojo">1</span>
			<a class="absolute text-center text-white bottom-2 right-4 lg:bottom-8 lg:right-8" href={`/topten/${posts[0].slug}/`}>
				<div class="mb-8 sm:mb-2 lg:mb-8 rojo cursor-pointer" data-podcast-status="ready"> 
					<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler bg-[#f61842] hover:bg-black rounded-[50%] p-[15px] m-auto icon-tabler-player-play" width="100" height="100" viewBox="0 0 24 24" stroke-width="2" stroke="#fff" fill="#fff" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
				</div> 
	            <p class="text-xl font-bold text-right m-0" set:html={posts[0].title.rendered}></p>
				<p class="text-xl text-right m-0" set:html={posts[0].acf.artista}></p>
			</a>
		</div>
		<div class="news-content audiopod w-[100%] md:w-[50%] py-2 pr-4">
			<!--p class="getcancion" data-cancion={posts[0].title.rendered} data-artista={posts[0].acf.artista}></p-->
			<p class="letra-de-cancion" set:html={posts[0].acf.letra_de_cancion}></p>
			<a href={`/topten/${posts[0].slug}/`}>
			<div class="letra flex nowrap z-10 items-center text-white text-xs bg-[#f61842] w-[35%] h-[20%] rounded-xl absolute top-0 bottom-0 right-0 left-0 m-auto">
				<svg class="w-[40%]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" stroke-width="2">
  					<path d="M4 20l3 0"></path><path d="M14 20l7 0"></path><path d="M6.9 15l6.9 0"></path><path d="M10.2 6.3l5.8 13.7"></path><path d="M5 20l6 -16l2 0l7 16"></path>
				</svg>
				<p class="w-[60%] m-0">Ver la Letra Completa</p>
			</div>
			</a>
        </div>
    </div>

<!--div class="main-topten" data-flickity='{ "lazyLoad": 1, "wrapAround": true, "cellAlign": "center", "pageDots": false, "autoPlay": true}'-->
<div class="topten main-topten mt-8">
	{
	posts.map((post:any, index)=> (
		<a class=" flex flex-col items-center text-black hover:text-[#7b439b] w-1/2 sm:w-1/3 lg:w-1/4 px-8 m-4" href={`/topten/${post.slug}/`}>
			<div class="w-12/12 text-center">
				<Image class="block h-auto w-full shadow-[0_2px_12px_7px_rgba(0,0,0,0.4)] rounded-[50%] object-fill" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['thumbnail'].source_url} width="300" height="150" alt="Imagen Ilustrativa Top Ten"  />
			</div>
			<div class="flex flex-wrap items-center">
				<div class="w-4/12">
					<span class="text-4xl rojo font-bold" set:html={index+1}></span>
				</div>
				<div class="w-8/12">
					<p class="font-bold leading-none m-0 text-xs" set:html={post.acf.artista}></p>
					<p class="font-bold leading-none m-0 text-xs text-zinc-500 font-normal" set:html={post.title.rendered}></p>
				</div>
			</div>
		</a>
	))    
	}
</div>




<style>
.carousel-cell {
  width: 150px;
  height: 200px;
  margin-right: 80px;
  border-radius: 20px;
}

.carousel-cell img{
	border-radius: 50%;
	box-shadow: 0 2px 12px 7px rgba(0,0,0,0.4);
	margin-top: 20px;
}

.carousel-cell.is-selected {
  /*background: #ED2;*/
}

.news-content{
	padding: 20px;
	position: relative ;
	padding-left: 40px;
	padding-right: 40px;
}
.news-content::after{
	content: '';
	width: calc(100% - 40px);
	height: 100%;
	background: #ededed;
	background: linear-gradient(0deg,rgba(237, 237, 237, 1) 0%, rgba(237, 237, 237, 0) 100%);
	display: inline-block;
	position: absolute;
	top: 0;
	border-radius: 0.75rem;
}
.getcancion, .letra-de-cancion {
  line-height: 1.6;
 	display: -webkit-box;
  -webkit-line-clamp: 9;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 1280px){
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 7;
	}
}
@media (max-width: 950px){
	.news-content .letra p{
		font-size: 12px;
		line-height: 1;
	}
	.getcancion, .letra-de-cancion {
		-webkit-line-clamp: 6;
	}
}


</style>