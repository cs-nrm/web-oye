---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';

const ressti = await fetch("https://contenido.oyedigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,acf,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=20&categories=149,6616,172,156,8791");
const poststi = await ressti.json();

---
{
  poststi
  .slice(0,1)
  .map((poststi:any) => (

    <div class="hero">

      <a href="/podcast/la-regadera">
      <Image class="logo-box" width="300" height="100" alt="Logo Oye" src="https://storage.googleapis.com/nrm-web/oye/recursos/main-logo-banderin.svg"/>
      </a>
      <a href="/programacion">

        <!--img class="img-prin" src="https://contenido.oyedigital.mx/wp-content/uploads/2025/06/portada-la-regadera-canva.png" alt="Imagen La Nota"-->
        <img class="img-prin" src="https://storage.googleapis.com/nrm-web/oye/recursos/PORTADA-TAYLOR-WEB2-2-min.jpg" alt="Imagen La Nota">
        
        <!--div class="gradient-overlay"></div-->
        <!--div class="hero-content">
          <h1 set:html={poststi.title.rendered}></h1>
          <div class="text" set:html={poststi.excerpt.rendered}></div>
          <div class="author">por {poststi.yoast_head_json.author}</div>
        </div-->
      </a>
    </div>
  ))
}
