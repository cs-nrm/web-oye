<style>
/*.cards img{
  mask-image: linear-gradient(225deg, hsla(var(--color-black), 1) 0, hsla(var(--color-black), 0.9) 40%, hsla(var(--color-black), 0) 80%);
}*/

.hero {
  position: relative;
  /*height: 600px;*/
  color: white;
}
.logo-box{
  width: 17%;
  position: absolute;
  top: 0;
}

.hero .img-prin {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gradient-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}

.hero-content {
  position: absolute;
  bottom: 7%;
  left: 0;
  right: 0;
  padding: 1rem 1.5rem;
  max-width: 45%;
  text-align: left;
  background: black;
}
.hero-content .author {color: white;}

.hero .category {
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 1rem;
  font-family: 'Lovelo'
}

.hero h1 {
  font-family: 'Roboto';
  font-weight: bold;
  font-size: 2rem;
  margin-bottom: 1rem;
  line-height: 1.2;
 	display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hero-content .text {
  font-size: 1rem;
  margin-bottom: 1rem;
  line-height: 1.3;
	display: -webkit-box;
	-webkit-margin-before: 0;
  margin-block-start: 0;
  -webkit-margin-after: 12px;
  margin-block-end: 12px;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hero-content .text p a:last-child {
    display: none;
}

.hero .author {
  font-size: 0.875rem;
  font-family: 'Roboto';
  font-weight: bold;
}

@media (max-width: 1023px) {
  /*.hero-content{max-width: 100%;}*/
  .hero h1 {font-size: 1.2rem;}
  .hero-content .text{font-size: 0.8rem;}
  .hero .author {display: none;}
}

@media (max-width: 640px) {
  /*.hero .img-prin {height: 400px;}*/
  .logo-box{width: 25%;}
  .hero-content{position: relative; max-width: 100%;}
  .hero-content .text{display: -webkit-box; font-size: 0.8rem;}
  .hero .author {display: block;}
}
</style>

