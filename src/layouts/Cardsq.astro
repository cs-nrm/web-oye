---
export interface Props {
    post: {
      imagePath: string;
      title: {
         rendered: string;
      }
      content: string;
      excerpt:{
        rendered: string;
      }
      slug: string;
      categories : {};
      yoast_head_json: {
         og_image: [
            {
               url: string;
            }
         ]
         article_published_time: string;
         author:string;         
      }




    };
    
}

const { post } = Astro.props;

var url_seccion;
console.log(post.categories[0]);
switch (post.categories[0]){
    case 149:        
        url_seccion = 'breakingnews';
    break;
    case 172:        
        url_seccion = 'kpop';
    break;
    case 6616:
        url_seccion = 'cine';
    break;
    case 8791:
        url_seccion = 'lifestyle';
    break;
    case 156:
        url_seccion = 'entrevistas';
    break;
    case 10680:
        url_seccion = 'talento';
    break;
    case 1606:
        url_seccion = 'promociones';
    break;
    default:
        url_seccion = 'breakingnews';    
    break;      
}


/*const section = post.yoast_head_json.schema['@graph'][0].articleSection; 
console.log(section);*/

---
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/${url_seccion}/${post.slug}/`}>
              <div><img class="rounded-xl" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Nota"/></div>
              <div class="news-content">
                <p set:html={post.title.rendered}></p>
              </div>
            </a>  
          </article>


<style>
    .news-content p{
    font-size: 1rem;
    padding: 15px 0;
    line-height: 1;
    font-weight: bold;
    }
</style>