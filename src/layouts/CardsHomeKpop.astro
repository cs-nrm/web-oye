---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const ressti = await fetch("https://playnrm.com/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,acf,_links,_embedded&_embed&per_page=3&categories=172");

const posts = await ressti.json();

---
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Noticia principal (66%) -->
        <div class="md:col-span-1">
          <a href={`/kpop/${posts[0].slug}/`}>
          <div class="relative h-full">
            <img class="rounded-xl w-full h-full object-cover" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/>
            <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-4 w-full rounded-b-xl">
              <p class="text-md font-semibold mb-0 leading-5" set:html={posts[0].title.rendered}></p>
            </div>
          </div>
          </a>
        </div>

        <!-- Columna lateral con dos noticias secundarias -->
        <div class="flex flex-col gap-4">
          <!-- Secundaria 1 -->

          <div class="relative h-1/2">
            <a href={`/kpop/${posts[1].slug}/`}>
              <img class="rounded-xl w-full h-full object-cover" src={posts[1]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                <p class="text-md font-semibold rounded-b-xl mb-0 leading-5" set:html={posts[1].title.rendered}></p>
              </div>
            </a>
          </div>
          <!-- Secundaria 2 -->
          <div class="relative h-1/2">
            <a href={`/kpop/${posts[2].slug}/`}>
              <img class="rounded-xl w-full h-full object-cover" src={posts[2]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/>
              <div class="absolute bottom-0 left-0 bg-black bg-opacity-60 text-white p-3 w-full rounded-b-xl">
                <p class="text-md font-semibold rounded-b-xl mb-0 leading-5" set:html={posts[2].title.rendered}></p>
              </div>
            </a>
          </div>
        </div>
      </div>
