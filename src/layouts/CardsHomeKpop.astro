<div class="m-auto text-center">
    <a href="/kpop" class="text-white hover:text-black">
        <button class="ver-mas group relative rounded-sm h-8 m-2 overflow-hidden bg-[#e2241a] uppercase text-xs font-bold tracking-[1px]">
            <span class="p-4">MÁS K-POP AQUÍ</span>
        </button>
    </a>
</div>

<style>
.platforms-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem;
  align-items: center;
}

.platform-card {
  position: relative;
  overflow: hidden;
  border-radius: 0.5rem;
  background: #111;
  transition: transform 0.3s ease;
}

.platform-card:hover {
  transform: translateY(-4px);
}
.news-content p{
  font-size: 1rem;
  padding: 5px 0;
  line-height: 1;
  font-weight: bold;
}

.platform-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.platform-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
}

.platform-content h3 {
  font-size: 1.25rem;
  font-weight: bold;
  margin-bottom: 0.5rem;
  color: white;
}

.platform-name {
  font-size: 0.875rem;
  color: #e2241a;
  text-transform: uppercase;
  font-family: 'Roboto';
}
@media (max-width: 640px) {
  .platforms-grid {
    grid-template-columns: repeat(1, 1fr);
    gap: 0;
  }
}

@media screen and (max-width: 1023px) and (min-width: 850px) {
  .derecha{padding: 1rem;}
}
</style>