---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const ressti = await fetch("https://contenido.oyedigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,acf,_links,_embedded&_embed&per_page=3&categories=172");

const posts = await ressti.json();

---
<div class="platforms-grid">
    <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
      <a href={`/kpop/${posts[0].slug}/`}>
        <div><img class="rounded-xl inset-0 h-auto sm:h-80 md:h-96 w-full shadow-lg object-cover object-center" src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/></div>
        <div class="news-content">
          <p set:html={posts[0].title.rendered}></p>
        </div>
      </a> 
    </article>

    <div class="derecha">
    <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
      <a href={`/kpop/${posts[1].slug}/`}>
        <div><img class="rounded-xl" src={posts[1]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/></div>
          <div class="news-content">
          <p set:html={posts[1].title.rendered}></p>
        </div>
      </a>
    </article>
    <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]"> 
      <a href={`/kpop/${posts[2].slug}/`}>
        <div><img class="rounded-xl" src={posts[2]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt="Imagen Breaking News"/></div>
        <div class="news-content">
          <p set:html={posts[2].title.rendered}></p>
        </div>
      </a>  
    </article>
    </div>
</div>

<style>
.platforms-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem;
  align-items: center;
}

.platform-card {
  position: relative;
  overflow: hidden;
  border-radius: 0.5rem;
  background: #111;
  transition: transform 0.3s ease;
}

.platform-card:hover {
  transform: translateY(-4px);
}
.news-content p{
  font-size: 1rem;
  padding: 5px 0;
  line-height: 1;
  font-weight: bold;
}

.platform-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.platform-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
}

.platform-content h3 {
  font-size: 1.25rem;
  font-weight: bold;
  margin-bottom: 0.5rem;
  color: white;
}

.platform-name {
  font-size: 0.875rem;
  color: #f61842;
  text-transform: uppercase;
  font-family: 'Roboto';
}
@media (max-width: 640px) {
  .platforms-grid {
    grid-template-columns: repeat(1, 1fr);
    gap: 0;
  }
}

@media screen and (max-width: 1023px) and (min-width: 850px) {
  .derecha{padding: 1rem;}
}
</style>