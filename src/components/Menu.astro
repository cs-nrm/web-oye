<style>
@media(min-width:1321px){
  .menu-mobile{display: none;}
  .menu-mobile-radio{display: none;}
}
@media (max-width: 1320px) {
.menutres {
  display: flex;
  flex-direction: row;
  gap: 1rem;
}
.menutres >{
  flex: 1 0 50%;
}
.menutres:first-child{
  flex: 0 1 50%;
}
  .logo{
    justify-content: left;
  }
  button{
    justify-content: right;
  }
  .menutres:after { content:  'ᐅ'; font-size: 18px; position: absolute; top: 30%; right: 4px; color: white;}
  .links-menu{
    display: none;
  }
}

.active a{
  background-color: #000; 
  color: white;
  padding: 0 3px;
}

.menu-mobile{
  white-space: nowrap;
  overflow-x: scroll;
  -ms-overflow-style: none;  /* Internet Explorer 10+ */
  scrollbar-width: none;  /* Firefox */
  margin-right: 15px;
}
.menu-mobile::-webkit-scrollbar { 
    display: none;  /* Safari and Chrome */
}


/*nav::before {content:''; width: 100%; height: 100%; position: absolute; background:black; top:0; z-index: -1;}*/
.link-menu{height: 39px;}
.menu-mobile ul li a, .link-menu a {color:white;  font-size: 17px;}
/*.main-logo {  width: 100px; height: 100%;}
.main-logo img{ width: 100%; height: auto;}*/
button.radio-button {    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 16px;
    color: var(--red-color);
    font-weight: 700;
    text-transform: uppercase;
    padding-left: 25px;
    margin-right: 20px;}
.opacity-back {position: absolute;    top: 0;    left: 0;    backdrop-filter: brightness(60%) blur(16px);    width: 100%;    height: 100%;    z-index: -1;  }

nav ul {
  padding: 0;
  margin: 0;
  list-style: none;
  position: relative;
  overflow: visible;
  display: flex;
}
  
nav ul li {
  display:inline-block;
}

nav a, .dd-menu, .dd-menu-2 {
  display:block;
  padding:0 10px; 
  color:#FFF;
  font-size:17px;
  text-decoration:none;
  position: relative;
  line-height: 1.2;
  overflow: visible;
}
.dd-menu-2{
  color: #000;
  display: flex !important;
  gap: 7px;
  align-items: center;
  cursor: pointer;
}

.dd-menu ul, dd-menu-2 ul{
  width: 158px;
}
.dd-menu ul li, dd-menu-2 ul li{
  margin-bottom: 8px;
}

nav a:hover, dd-menu:hover { 
  background-color: #000; 
}

/* Hide Dropdowns by Default */
nav ul ul {
  display: none;
  position: absolute; 
  /*backdrop-filter: brightness(60%) blur(16px);*/
  top: 22px;
  left: 0;
  overflow: visible;
  padding: 15px;
  background: black;
}
nav ul .dd-menu-2 ul {
  top: 22px;
  right: 0;
  left: auto;
  justify-content: space-around;
  justify-items: center;
}
  
/* Display Dropdowns on Hover */
nav ul li:hover > ul {
  display: inherit;
}
nav ul li.dd-menu ul li a:hover, nav ul li.dd-menu-2 ul li a:hover {
  background: var(--red-color);
}
  
/* Fisrt Tier Dropdown */
nav ul ul li {
  /*width:190px;*/
  float:none;
  display:list-item;
  position: relative;
}
nav ul .dd-menu-2 ul li {
  text-align: center;
}

/* Second, Third and more Tiers */
nav ul ul ul li {
  position: relative;
  top:-60px; 
  left:170px;
}

  
/* Change this in order to change the Dropdown symbol */
li > a:after, .dd-menu:after, .dd-menu-2:after { content:  ' ▼'; font-size: 10px;}
li > a:only-child:after, li > .dd-menu:only-child:after { content: ''; }

.live-icon {
    display: inline-block;
    position: relative;
    top: calc(50% - 5px);
    background-color: var(--red-color);
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    z-index: 1;
}
.live-icon:before {
    content: "";
    display: block;
    position: absolute;
    background-color: rgba(255, 0, 0, 0.6);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    -webkit-animation: live 2s ease-in-out infinite;
    animation: live 2s ease-in-out infinite;
    z-index: -1;
}
@keyframes live {
  0% {
    transform: scale(1, 1);
  }
  100% {
    transform: scale(3.5, 3.5);
    background-color: rgba(255, 170, 31, 0);
  }
}

</style>

