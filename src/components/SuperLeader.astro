---
<div class="super-leader my-9 table mx-auto text-center w-full lg:w-[970px] h-[90px]">
	<span class="text-xs text-zinc-500">PUBLICIDAD</span>
   <div id="ad-slot6" class="hidden md:block" style="display:none;"></div>
   <div id="ad-slot61" class="md:hidden block" style="display:none;"></div>
   <div id="ad-slot6-adsense" style="display:none;">

	<ins class="adsbygoogle"
		style="display:block; height:90px; width:100%;"
		data-ad-client="ca-pub-7423640555477330"
		data-ad-slot="2069668179"
		data-ad-format="horizontal"
		data-full-width-responsive="true"></ins>

   </div>

   	<script is:inline>
     (function() {
         if (!window.superLeaderListenerAdded) {
             window.superLeaderListenerAdded = true;
             window.googletag = window.googletag || {cmd: []};
             window.googletag.cmd.push(function() {
                 window.googletag.pubads().addEventListener('slotRenderEnded', function(event) {
                     const slotId = event.slot.getSlotElementId();
                     if (slotId === 'ad-slot6' || slotId === 'ad-slot61') {
                         const adEl = document.getElementById(slotId);
                         const fallEl = document.getElementById('ad-slot6-adsense');
                         
                         if (event.isEmpty) {
                             if (adEl) adEl.style.display = 'none';
                             if (fallEl && fallEl.style.display === 'none') {
                                 fallEl.style.display = 'block';
                                 try { window.adsbygoogle = window.adsbygoogle || []; window.adsbygoogle.push({}); } catch(e){}
                             }
                         } else {
                             window.superLeaderGptLoaded = true;
                             if (adEl) adEl.style.display = '';
                             if (fallEl) fallEl.style.display = 'none';
                         }
                     }
                 });
             });
         }

         document.addEventListener("astro:page-load", () => {
             window.superLeaderGptLoaded = false;
             setTimeout(() => {
                 const fallEl = document.getElementById('ad-slot6-adsense');
                 if (!window.superLeaderGptLoaded && fallEl && fallEl.style.display === 'none') {
                     fallEl.style.display = 'block';
                     try { window.adsbygoogle = window.adsbygoogle || []; window.adsbygoogle.push({}); } catch(e){}
                 }
             }, 3000);
         });
     })();
   </script>
</div>
