<style>
	footer {
		/*padding: 2em 1em 6em 1em;*/
		background: black;
		color: white;
		text-align: center;
	}

	.redes-container{
	font-family: "Montserrat";
	background-color: #F4F4F4;
	color: #656565;
}
.redes-2025{
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 2rem;
	font-size: 14px;
}
.redes-2025 .social-icons, .redes-2025 .apps-icons,  .redes, .apps{
	display: flex;
	flex-wrap: nowrap;
	align-items: center;
	justify-content: center;
	text-align: center;
}
.logo-estacion img{
	width: 100%;
	height: auto;
	max-width: 120px;
}
.footer-2025 {
	font-family: "Montserrat";
    background-color: black;
    color: white;
    padding: 2rem 0;
	padding-bottom: 150px;
}
.container {
    margin: 0 auto;
    padding: 0 1rem;
	max-width: 1320px;
}

/* Logo section */
.logo-section, .second-section {
    display: flex;
    /*flex-wrap: wrap;*/
    justify-content: space-between;
	align-items: center;
    gap: 2rem;
    /*margin-bottom: 1.5rem;
	display: grid;
	grid-template-columns: repeat(6, 1fr);
	gap: 10px;
	grid-auto-rows: minmax(100px, auto);*/
}
.second-section{
	align-items: normal;
	margin-top: 1rem;
}
.nrm-logo {
    font-size: 1.5rem;
    font-weight: bold;
}
.logo-section img {
    object-fit: contain;
}
/*.logo-section span.separator{
	font-size: 80px;
	color: #adadad;
}*/

/* Links section */
.links-section {
    display: flex;
    flex-wrap: wrap;
	align-items: center;
    justify-content: center;
    gap: 10px;
	line-height: 1;
    margin-bottom: 1rem;
}
.link-ventas {
    color: #FCD34D;
    text-decoration: none;
}
.link-privacy,
.link-terms {
    color: #60A5FA;
    text-decoration: none;
}
.link-ventas:hover,
.link-privacy:hover,
.link-terms:hover {
    text-decoration: underline;
	color: white;
}
.separator {
    color: #6B7280;
}

/* Copyright */
.copyright {
    text-align: center;
    color: #9CA3AF;
}

/* Responsive design */
@media (min-width: 1000px) {
	.logo-section img {
   		max-width: 110px;
	}
}
@media (max-width: 768px) {
	.redes-2025{
		font-size: 1.3vw;
	}
    .logo-section {
        gap: 1.5rem;
    }
    .second-section {
        flex-direction: column;
		gap:0;
        align-items: center;
        text-align: center;
    }
}
@media (max-width: 600px) {
	.redes-2025{
		font-size: 2vw;
	}
	.social-icons, .apps-icons{
		flex-direction: column;
	}
    .separator {
   	    display: none;
   	}
	/*.pre-site-header .separator{
		display: block;
	}*/
	.play-circle {
	    width: 52px !important;
   		height: 52px !important;
	}
}
</style>	

