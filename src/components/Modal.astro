#modal .modals {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.7);
  position: fixed;
  top: 0;
  left: 0;
  display: flex;
  visibility: hidden;
  opacity: 0;
  max-height: 100% !important;
  z-index: 10000;
  overflow: scroll;
}
#modal .contenido {
  margin: auto;
  /*width: 75%;*/
  padding: 2% 0;
}
#modal .contenido .unilogo img{
  width: 100%;
  height: auto;
}
#modal .contenido video{
  width: 100%;
  height: auto;
  max-width: 900px;
}
#modal .contenido #videopromo{
  width: 100%;
  height: auto;
  margin: 0 auto;
}
#modal .contenido .info {
  font-size: 23px;
  position: relative;
  top: 15px;
  color: #52fdfd;
  font-weight: bold;
  text-shadow: 5px 5px 5px #8286ab;
}
#modal .contenido .info b{color: white;}
	
#modal .contenido a.info:hover{
  color: white;
  cursor: pointer;
}
#modal .contenido img {
  /*width: auto;
  height: auto;
  max-width: 600px;
  max-height: 800px;*/
}
#modal #cerrar {
  display: none;
}
#modal #cerrar + label {
  position: fixed;
  color: #fff;
  font-size: 27px;
  z-index: 10010;
  background: darkred;
  height: 40px;
  width: 40px;
  line-height: 40px;
  border-radius: 50%;
  right: 5%;
  top: 5%;
  cursor: pointer;
  visibility: hidden;
  opacity: 0;
}
/* El modal solo aparece cuando GAM entrega un takeover: ads.js agrega .con-anuncio
   en slotRenderEnded. Sin campana activa no se muestra un velo vacio.
   trampa: al terminar la animacion se oculta solo; 30s (~27s visible) para que quepa
   un spot de video de 20s. */
#modal.con-anuncio .modals,
#modal.con-anuncio #cerrar + label {
  animation-name: modal;
  animation-duration: 30s;
  animation-delay: 0s;
}

/* Video intersticial: sin temporizador; videoIntersticial.js quita .con-video al terminar
   el anuncio o al cerrar con la X. */
#vi-wrap { display: none; }
#modal.con-video .modals,
#modal.con-video #cerrar + label {
  visibility: visible;
  opacity: 1;
}
#modal.con-video .modal-video { display: none; }
#modal.con-video #vi-wrap {
  display: block;
  position: relative;
  width: min(92vw, 800px);
  aspect-ratio: 16 / 9;
  margin: 0 auto;
  background: #000;
}
#vi-video, #vi-ad {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
#vi-sonido {
  position: absolute;
  left: 8px;
  bottom: 8px;
  z-index: 2;
  padding: 6px 12px;
  border: 0;
  border-radius: 16px;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 13px;
  cursor: pointer;
}
#modal #cerrar:checked + label, #modal #cerrar:checked ~ .modals {
  display: none;
}
#modal [type=checkbox] + label {
  padding-left: 11px !important;
}
#modal [type=checkbox] + label:before, #modal [type=checkbox]:not(.filled-in) + label:after {
  border: none;
}
@keyframes modal {
  0% {
    visibility: visible;
    opacity: 1;
  }
  25% {
    visibility: visible;
    opacity: 1;
  }
  50% {
    visibility: visible;
    opacity: 1;
  }
  90% {
    visibility: visible;
    opacity: 1;
  }
  100% {
    visibility: hidden;
    opacity: 0;
  }
}
	
#modal .contenido .container-iframe {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
}
#modal .contenido .container-iframe iframe {
