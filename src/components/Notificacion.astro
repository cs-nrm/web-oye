<link rel="stylesheet" type="text/css" href="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/normalize.css" />
<link rel="stylesheet" type="text/css" href="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/ns-default.css" />
<link rel="stylesheet" type="text/css" href="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/ns-style-attached.css" />
<link rel="stylesheet" type="text/css" href="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/ns-style-other.css" />

<script is:inline>
  const anio = 2026;
  const mes = 6;
  const dia = 1;
  const diafin = 31;
  const horaInicio = { h: 10, m: 20 };
  const horaFin = { h: 23, m: 59 };

  function estaEnRango() {
    const ahora = new Date();
    const inicio = new Date(anio, mes, dia, horaInicio.h, horaInicio.m, 0, 0);
    const fin = new Date(anio, mes, diafin, horaFin.h, horaFin.m, 0, 0);
    return ahora >= inicio && ahora <= fin;
  }

  // Flag global para no mostrar la notificación más de una vez por sesión
  if (!window._notifActiva) {
    window._notifActiva = false;
    window._notifInterval = null;

    function mostrarNotificacion() {
      if (window._notifActiva) return;
      window._notifActiva = true;

      var notification = new NotificationFx({
        wrapper : document.body,
        message : '<div class="fondo-live"><a target="_" href="https://fiestafutbol.com.mx/"><h3>Gracias por ser parte de La Fiesta del Fútbol</h3><svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-hand-click" width="54" height="54" viewBox="0 0 24 24" stroke-width="1.5" stroke="#fff" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 13v-8.5a1.5 1.5 0 0 1 3 0v7.5" /><path d="M11 11.5v-2a1.5 1.5 0 0 1 3 0v2.5" /><path d="M14 10.5a1.5 1.5 0 0 1 3 0v1.5" /><path d="M17 11.5a1.5 1.5 0 0 1 3 0v4.5a6 6 0 0 1 -6 6h-2h.208a6 6 0 0 1 -5.012 -2.7l-.196 -.3c-.312 -.479 -1.407 -2.388 -3.286 -5.728a1.5 1.5 0 0 1 .536 -2.022a1.867 1.867 0 0 1 2.28 .28l1.47 1.47" /><path d="M5 3l-1 -1" /><path d="M4 7h-1" /><path d="M14 3l1 -1" />  <path d="M15 6h1" /></svg></a></div>',
        layout : 'attached',
        effect : 'bouncyflip',
        ttl: 90000,
        type : 'notice',
        onClose : function() { window._notifActiva = false; return false; },
        onOpen : function() { return false; }
      });
      notification.show();

      const ahora = new Date();
      const fin = new Date();
      fin.setHours(horaFin.h, horaFin.m, 0, 0);
      const msRestantes = fin - ahora;
      if (msRestantes > 0) {
        setTimeout(() => {
          notification.dismiss();
          window._notifActiva = false;
        }, msRestantes);
      }
    }

    function revisarNotificacion() {
      if (estaEnRango()) mostrarNotificacion();
    }

    // Limpia el interval al navegar para no acumular timers
    document.addEventListener('astro:before-preparation', function() {
      if (window._notifInterval) {
        clearInterval(window._notifInterval);
        window._notifInterval = null;
      }
    });

    setTimeout(revisarNotificacion, 100);
    window._notifInterval = setInterval(revisarNotificacion, 60000);
  }
</script>

<script is:inline src="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/classie.js"></script>
<script is:inline src="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/modernizr.custom.js"></script>
<script is:inline src="https://storage.googleapis.com/nrm-web/nrm/lib/notificacion/notificationFx.js"></script>
