<div class="leader my-9 table mx-auto text-center">
	<span class="roboto text-xs text-zinc-500">PUBLICIDAD</span> 
	<!--img src="https://contenido.beatdigital.mx/wp-content/uploads/2024/07/leader.png" alt="leader" width="728" height="90"/-->
    <div id="ad-slot4" class="hidden md:block" style="display:none;"></div>
    <div id="ad-slot41" class="md:hidden block" style="display:none;"></div>
    <div id="ad-slot4-adsense" style="display:none;">
		<ins class="adsbygoogle"
		style="display:block; height:90px; width:100%;"
		data-ad-client="ca-pub-7423640555477330"
		data-ad-slot="5115879668"
		data-ad-format="horizontal"
		data-full-width-responsive="true"></ins>
   	</div>

   	<script is:inline>
     (function() {
         if (!window.leaderBoardListenerAdded) {
             window.leaderBoardListenerAdded = true;
             window.googletag = window.googletag || {cmd: []};
             window.googletag.cmd.push(function() {
                 window.googletag.pubads().addEventListener('slotRenderEnded', function(event) {
                     const slotId = event.slot.getSlotElementId();
                     if (slotId === 'ad-slot4' || slotId === 'ad-slot41') {
                         const adEl = document.getElementById(slotId);
                         const fallEl = document.getElementById('ad-slot4-adsense');
                         
                         if (event.isEmpty) {
                             if (adEl) adEl.style.display = 'none';
                             if (fallEl && fallEl.style.display === 'none') {
                                 fallEl.style.display = 'block';
                                 try { window.adsbygoogle = window.adsbygoogle || []; window.adsbygoogle.push({}); } catch(e){}
                             }
                         } else {
                             window.leaderBoardGptLoaded = true;
                             if (adEl) adEl.style.display = '';
                             if (fallEl) fallEl.style.display = 'none';
                         }
                     }
                 });
             });
         }

         document.addEventListener("astro:page-load", () => {
             window.leaderBoardGptLoaded = false;
             setTimeout(() => {
                 const fallEl = document.getElementById('ad-slot4-adsense');
                 if (!window.leaderBoardGptLoaded && fallEl && fallEl.style.display === 'none') {
                     fallEl.style.display = 'block';
                     try { window.adsbygoogle = window.adsbygoogle || []; window.adsbygoogle.push({}); } catch(e){}
                 }
             }, 3000);
         });
     })();
   </script>
    

</div>