---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import AdScripts from './head/AdScripts.astro';
import AnalyticsScripts from './head/AnalyticsScripts.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	seccion: string;
}



const { title, description, image = '/oye-share.jpg', seccion } = Astro.props;

---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
<link rel="manifest" href="/favicon/site.webmanifest">
<link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#5bbad5">
<meta name="msapplication-TileColor" content="#da532c">
<meta name="theme-color" content="#ffffff">
<meta property="fb:app_id" content="746588188144228" />

<!-- sitemap -->
<link rel="sitemap" href="/sitemap.xml" />
<meta name="robots" content="index, follow" />
<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Caché -->
<meta http-equiv="cache-control" content="max-age=3600, stale-while-revalidate=300" />

<AdScripts />
<AnalyticsScripts />

<!-- TONEFUSE APPLE MUSIC -->
<script async src="https://srv.tunefindforfans.com/fruits/mangos.js"></script>

