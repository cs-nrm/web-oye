---
import Layout from "../../layouts/Layout.astro";
import Card from "../../layouts/CardsPoptrends.astro";
import DoubleBox from "../../components/DoubleBox.astro";
import BoxBanner from "../../components/BoxBanner.astro";
import LeaderBoard from "../../components/LeaderBoard.astro";

const res = await fetch(
    "https://playnrm.com/wp-json/wp/v2/posts?_embed&per_page=20&categories=280&_fields=id,title,yoast_head_json,content,slug,categories,acf",
);
const posts = await res.json();

posts.sort(function (a, b) {
    return a.acf.posicion > b.acf.posicion
        ? 1
        : a.acf.posicion < b.acf.posicion
          ? -1
          : 0;
});
---

<Layout title="Top Ten">
    <div class="container mb-12 px-[5px] mx-auto md:px-12" id="content-w-video">
        <LeaderBoard />
        <h1
            class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl"
            set:html={posts[0].acf.titulo_lista}
        ></h1>
        <div class="flex flex-col lg:flex-row">
            <div class="sm:min-w-[calc(100%-400px)] lg:mr-10">
                <section class="flex flex-wrap w-full m-auto">
                    {posts.map((post: any) => <Card {post} />)}
                </section>
            </div>
            <div
                class="bg-gray-300 p-5 rounded-md sm:min-w-[350px] relative text-center md:text-left"
            >
                <div class="sticky top-0 left-0 right-0">
                    <BoxBanner />
                    <br />
                    <DoubleBox />
                </div>
            </div>
        </div>
    </div>

    <link
        rel="stylesheet"
        type="text/css"
        href="https://storage.googleapis.com/nrm-web/nrm/lib/toastify.css"
        slot="head"
    />
    <script
        is:inline
        src="https://storage.googleapis.com/nrm-web/nrm/lib/toastify.js"
        slot="head"></script>
</Layout>
