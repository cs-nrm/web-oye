---
import Layout from "../../layouts/Layout.astro";
import { getArticles } from "../../lib/api.js";
import Card from "../../layouts/Cards.astro";
import DoubleBox from "../../components/DoubleBox.astro";
import BoxBanner from "../../components/BoxBanner.astro";
import LeaderBoard from "../../components/LeaderBoard.astro";

export async function getStaticPaths({ paginate }) {
  const data = await getArticles(1606);
  return paginate(data, { pageSize: 20 });
}

interface Props {
  page: any;
}

const { page = [] } = Astro.props;
---

<Layout title="Promociones">
  <div class="container mb-12 px-[5px] mx-auto md:px-12">
    <LeaderBoard />
    <h1
      class="titulos rojo uppercase goodtime text-center p-4 my-4 text-2xl lg:text-3xl"
    >
      Promociones
    </h1>
    <div class="flex flex-col lg:flex-row">
      <div class="sm:min-w-[calc(100%-400px)] lg:mr-10">
        <section
          class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 md:gap-8 xl:gap-8"
        >
          {page.data.map((post: any) => <Card post={post} />)}
        </section>
        <div class="m-auto text-center">
          {
            page.url.prev && (
              <a href={page.url.prev} class="text-white">
                <button class="ver-mas roboto group relative h-8 w-36 m-4 rounded-sm overflow-hidden bg-[var(--red-color)] hover:bg-black uppercase text-xs font-bold tracking-[3px]">
                  <span>Anterior</span>
                </button>
              </a>
            )
          }
          {
            page.url.next && (
              <a href={page.url.next} class="text-white">
                <button class="ver-mas roboto group relative h-8 w-36 m-4 rounded-sm overflow-hidden bg-[var(--red-color)] hover:bg-black uppercase text-xs font-bold tracking-[3px]">
                  <span>Siguiente</span>
                </button>
              </a>
            )
          }
        </div>
      </div>
      <div
        class="bg-black/20 p-5 sm:min-w-[350px] relative text-center md:text-left rounded-xl"
      >
        <div class="sticky top-[50px] left-0 right-0">
          <BoxBanner />
          <br />
          <DoubleBox />
        </div>
      </div>
    </div>
  </div>
</Layout>
