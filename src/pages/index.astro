                        <DoubleBox />
                    </div>
                </div>
            </div>
        </section>
        <LeaderBoard2 />
        <section>
            <div class="container-home px-[5px] py-4 md:p-4 mx-auto">
                <CardCine />
            </div>
        </section>
        <BillBoard2 />
        <section>
            <div class="container-home px-[5px] py-4 md:p-4 mx-auto">
                <CardGaming />
            </div>
        </section>
        <section>
            <div class="container-home px-[5px] py-4 md:p-4 mx-auto">
                <div class="flex flex-wrap items-start">
