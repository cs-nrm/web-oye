---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import Card from '../../layouts/CardsPodcast.astro';


 export function getStaticPaths() {    
    const arrpodcast = [
        {nodo: 9046,title: 'El camino de las estrellas con Jaidy Robles', link: 'el-camino-de-las-estrellas', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_elcamino-min.jpg', descripcion: '¿Te gustaría saber, cómo iniciaron tus artistas  favoritos?  Jaidy Robles te dirá detalle a detalle de tu artista y mucho más. '},
        {nodo: 9047,title: 'Aquí y Ahora platicamos con Sergio Mejía', link: 'aqui-y-ahora', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_aqui-min.jpg', descripcion: 'Lo importante de la vida es vivir en el Aquí y en el Ahora. Expertos llegan con Sergio Mejía para contarnos sobre sus experiencias y todo lo que saben. '},
        {nodo: 9048,title: 'Noticias que parecen broma pero no son con Aura Ramírez', link: 'noticias-que-parecen-broma-pero-no-son', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_noticias-min.jpg', descripcion: 'Ya llegóoooo el que será tu próximo podcast favorito. Soy Aura Ramírez y cada semana te traeré un combo de noticias que parecen falsas pero en realidad NO lo son. Prepara tu café, sírvete un pan y entérate de lo que pasa en el mundo con un toque de jiribilla, claro que sí.'},
        {nodo: 9049,title: 'Lo más viral con Emilio Catalán', link: 'lo-mas-viral', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_viral2-min-min.jpg', descripcion: 'Los trends de la semana y temas virales en redes sociales.'},
        {nodo: 9050,title: 'Tips y recomendaciones con Sharon Azoulay', link: 'tips-y-recomendaciones', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_tips-min.jpg', descripcion: 'Los mejores libros para leer y la belleza en un solo podcast. '},
        {nodo: 9051,title: 'Receta fit con la pelirroja de la radio', link: 'receta-fit', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_recetafit-min.jpg', descripcion:'Las mejores recetas fitness para tu día a día de forma fácil y rápida.'},
        {nodo: 9052,title: 'Alguien lo tiene que hacer con Poncho Yezka', link: 'alguien-lo-tiene-que-hacer', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_alguien-min.jpg', descripcion:''},
        {nodo: 3813,title: 'Top Tech con Geekzilla', link: 'top-tech', imagen: 'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/TOP-TECH-PODCAST.jpg', descripcion: 'Top Tech con Geekzilla. un podcast en el que conoceremos todo sobre la tecnología que nos está rodeando.'},
        {nodo: 3801,title: 'Top Gaming con Geekzilla', link: 'top-gaming', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/TOP-GAMING-450.jpg', descripcion:'Un clavado al mundo de los gamers en el cual conocerás todo sobre los lanzamientos, mejores juegos del momento y los que vienen.'},
        {nodo: 6581,title: 'Top Ten', link: 'top-ten', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/TOP-TEN-450.jpg', descripcion:'La música más top, nueva y relevante que escuchas, tu votas por tener tu canción en los 10 primeros lugares.'},
        {nodo: 7404,title: 'Oye la alternativa', link: 'oye-la-alternativa', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_alternativa.png', descripcion:'El espacio donde toda la música se escucha, sin distinción, entrevistas de todos los géneros en un solo lugar.'},
        {nodo: 6806,title: 'Al otro lado de la radio', link: 'al-otro-lado-de-la-radio', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/PODCAST_otro-lado.jpg', descripcion:'Un podcast donde podrás escuchar a tus artistas favoritos y conocer más sobre ellos.'},
        {nodo: 9138,title: 'Oye de Cine', link: 'oye-de-cine', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/podcast/OYE-CINE-450.jpg', descripcion:''},
        {nodo: 10689,title: 'La Regadera', link: 'la-regadera', imagen:'https://storage.googleapis.com/nrm-web/oye/recursos/PODCAST-OYE.png', descripcion:''},
    ]; 
    return arrpodcast.map((podcast) => {
      return {
        params: { link: podcast.link, imagen: podcast.imagen },
        props: { podcast, cat:podcast.nodo }
      };
  });
}


interface Props{ 
  podcast:any; 
  cat:string; 
}
//const { nodo, podcast } = Astro.params;
const { link } = Astro.params;
const { podcast } = Astro.props;
const { cat } = Astro.props ;

const res = await fetch("https://playnrm.com/wp-json/wp/v2/posts?_embed&fields=title,acf&per_page=10&categories=" + cat); 
const posts = await res.json();
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} seccion="Podcast" description={SITE_DESCRIPTION} />
         <meta charset="utf-8"/>
    </head>
    <body>
        <Header title={SITE_TITLE} />
        
        <main>
            <div class="container mb-12 px-[5px] py-4 mx-auto md:px-12">
                <div class="flex flex-wrap justify-center ">
                    <div class="w-full md:w-1/3 lg:w-1/4"><img class="content-center shadow-xl" src={podcast.imagen}/></div>
                    <div class="w-full md:w-2/3 lg:w:3/4 p-4 flex items-center">
                        <div>
                        <h1 class="audiowide neon-morado text-center md:text-left font-bold text-3xl md:text-4xl lg:text-3xl xl:text-4xl align-middle">{podcast.title} </h1>
                        <p class="align-middle">{podcast.descripcion}</p>
                        </div> 
                    </div>
                </div>
                <section class="flex flex-wrap">
                    {
                        posts.map((post:any) => ( 
                        <>
                            <Card {post} />
                        </>
                        ))
                    }
                </section>
                <div class="m-auto text-center">
                    <a href={`/podcast/${link}/2`} class="text-white hover:text-black">
                        <button class="ver-mas group relative h-8 w-36 m-4 overflow-hidden rounded-xl bg-[rgba(52,52,52,0.2)] hover:bg-white border-2 border-white uppercase text-xs poppins font-bold tracking-[3px]">
                            <span>Siguiente</span>
                        </button>
                    </a>
                </div>

                <div class="text-center">
                    <a href={`/podcast/${link}/2`}>
                        <button class="ver-mas group relative h-8 w-36 m-4 overflow-hidden rounded-lg bg-zinc-700 text-base shadow">
                            <div class="absolute inset-0 w-3 bg-[var(--amarillo-beat)] transition-all duration-[250ms] ease-out group-hover:w-full"></div>
                            <span class="relative text-zinc-200 group-hover:text-zinc-900">Siguiente</span>
                        </button>
                    </a>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>
