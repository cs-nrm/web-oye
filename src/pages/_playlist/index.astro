---
import Layout from "../../layouts/Layout.astro";

const lunes_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/lunes.json";
const martes_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/martes.json";
const miercoles_nojson =
    "https://cdn.nrm.com.mx/cdn/beat/playlist/miércoles.json";
const jueves_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/jueves.json";
const viernes_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/viernes.json";
const sabado_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/sábado.json";
const domingo_nojson = "https://cdn.nrm.com.mx/cdn/beat/playlist/domingo.json";

const fetchPlaylist = async (url) => {
    try {
        const text = await fetch(url).then((r) => r.text());
        return text
            .split("\n")
            .filter((line) => line.trim() !== "")
            .map((line) => {
                try {
                    const item = JSON.parse(line);
                    const categories = [
                        "RANDOM",
                        "MUSICA-DANCE",
                        "MUSICA-HOUSE",
                        "MÚSICA-DREAM",
                        "MUSICA-ELECTRONICA",
                        "MUSICA-PROGRESIVO",
                        "MUSICA-RETRO",
                        "MUSICA-RANDOM ANDRE",
                        "LADO F",
                    ];
                    if (categories.includes(item.categoria)) {
                        return item;
                    }
                    return null;
                } catch (e) {
                    return null;
                }
            })
            .filter((item) => item !== null);
    } catch (e) {
        return [];
    }
};

const lunes = await fetchPlaylist(lunes_nojson);
const martes = await fetchPlaylist(martes_nojson);
const miercoles = await fetchPlaylist(miercoles_nojson);
const jueves = await fetchPlaylist(jueves_nojson);
const viernes = await fetchPlaylist(viernes_nojson);
const sabado = await fetchPlaylist(sabado_nojson);
const domingo = await fetchPlaylist(domingo_nojson);

function getMes(mes) {
    const meses = [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre",
    ];
    return meses[parseInt(mes) - 1];
}

const formatPlaylistDate = (item) => {
    if (!item || !item.hora_real) return "";
    const parts = item.hora_real.split("T")[0].split("-");
    return `${parts[2]} de ${getMes(parts[1])}`;
};

const formatPlaylistTime = (timeStr) => {
    if (!timeStr) return "";
    const parts = timeStr.split("T")[1].split(":");
    return `${parts[0]}:${parts[1]}`;
};
---

<Layout title="Playlist">
    <div class="container my-12 mx-auto px-4">
        <h1
            class="audiowide neon-verde text-center md:text-left pt-4 font-bold text-4xl md:text-5xl lg:text-4xl xl:text-5xl mb-8"
        >
            PLAYLIST
        </h1>

        <form id="select-day" class="max-w-sm my-6">
            <label
                for="dias"
                class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                >Selecciona un día</label
            >
            <select
                id="dias"
                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
            >
                <option value="lunes">Lunes</option>
                <option value="martes">Martes</option>
                <option value="miercoles">Miércoles</option>
                <option value="jueves">Jueves</option>
                <option value="viernes">Viernes</option>
                <option value="sabado">Sábado</option>
                <option value="domingo">Domingo</option>
            </select>
        </form>

        {
            [
                { id: "lunes", label: "Lunes", data: lunes },
                { id: "martes", label: "Martes", data: martes },
                { id: "miercoles", label: "Miércoles", data: miercoles },
                { id: "jueves", label: "Jueves", data: jueves },
                { id: "viernes", label: "Viernes", data: viernes },
                { id: "sabado", label: "Sábado", data: sabado },
                { id: "domingo", label: "Domingo", data: domingo },
            ].map((day) => (
                <div id={day.id} class="day-section hidden first:block">
                    <div class="text-white text-xl font-bold mb-4">
                        {day.label}{" "}
                        {day.data.length > 0
                            ? formatPlaylistDate(day.data[0])
                            : ""}
                    </div>

                    <div class="overflow-x-auto rounded-lg">
                        <table class="w-full text-white border-collapse bg-gray-900/50">
                            <thead class="bg-gray-800/80">
                                <tr>
                                    <th class="px-4 py-3 text-left">Hora</th>
                                    <th class="px-4 py-3 text-left">Canción</th>
                                    <th class="px-4 py-3 text-left">DJ</th>
                                </tr>
                            </thead>
                            <tbody>
                                {day.data.map((el) => (
                                    <tr class="border-b border-gray-800 hover:bg-gray-700/40 transition-colors">
                                        <td class="px-4 py-3 whitespace-nowrap">
                                            {formatPlaylistTime(el.hora_real)}
                                        </td>
                                        <td class="px-4 py-3">{el.title}</td>
                                        <td class="px-4 py-3 whitespace-nowrap">
                                            {el.dj}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            ))
        }
    </div>
</Layout>

<script>
    const daySelect = document.getElementById("dias");
    const sections = document.querySelectorAll(".day-section");

    daySelect?.addEventListener("change", (e) => {
        const targetId = (e.target as HTMLSelectElement).value;
        sections.forEach((section) => {
            if (section.id === targetId) {
                section.classList.remove("hidden");
            } else {
                section.classList.add("hidden");
            }
        });
    });
</script>

<style>
    .neon-verde {
        text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
    }
</style>
